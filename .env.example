# Copia este archivo a .env.local y completa los valores

# === LOCAL (solo para desarrollo) ===
JWT_SECRET=
ALLOWED_ORIGIN=http://localhost:3000

# === PRODUCCIÓN (Vercel) ===
# Turso (https://docs.turso.tech/ -> Database -> Settings -> API Tokens)
TURSO_URL=libsql://TU-BASE.turso.io
TURSO_AUTH_TOKEN=tu-token-de-api-turso

# Vercel Blob (https://vercel.com -> Storage -> Blob -> Settings)
BLOB_READ_WRITE_TOKEN=

# Socket.IO server desplegado en Fly.io (dejar vacío en local)
NEXT_PUBLIC_SOCKET_URL=

# ICE/STUN servers para WebRTC
ICE_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302