# Copia este archivo a .env.local y completa los valores
# (https://docs.turso.tech/ -> Database -> Settings -> API Tokens)
TURSO_URL=libsql://TU-BASE.turso.io
TURSO_AUTH_TOKEN=tu-token-de-api-turso

# Vercel Blob (https://vercel.com -> Storage -> Blob -> Settings)
# Solo necesario en producción; en local se guarda en public/uploads
BLOB_READ_WRITE_TOKEN=

# Secreto JWT (genéralo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=